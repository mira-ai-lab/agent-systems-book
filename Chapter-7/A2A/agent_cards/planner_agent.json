      "tags": [
        "travel",
        "planning",
        "dependency",
        "dag",
        "input:query",
        "input:available_agents",
        "output:total_goal",
        "output:tasks",
        "output:execution_order"
      ],
      "examples": [
        "为大同两日游制定酒店查询任务，并说明任务依赖。"
      ]
    }
  ]
